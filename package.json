{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Portfolio landing page with astrophotography gallery, built with React, TypeScript, and Vite. Features TanStack Query, PWA support, advanced caching, and SEO optimization.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "start": "react-router dev",
    "build": "npm run type-check && react-router build",
    "build:client": "vite build -c vite.config.legacy.ts",
    "build:server": "vite build -c vite.config.legacy.ts --ssr ../src/entry-server.tsx --outDir ../dist/server",
    "build:ssr": "npm run build:client && npm run build:server",
    "dev:ssr": "node --watch --watch-path=src/api --watch-path=src/components --watch-path=src/context --watch-path=src/hooks --watch-path=src/styles --watch-path=src/types --watch-path=src/utils --watch-path=src/App.tsx --watch-path=src/AppShell.tsx --watch-path=src/HomePage.tsx --watch-path=src/entry-client.tsx --watch-path=src/entry-server.tsx --watch-path=src/i18n.client.ts --watch-path=src/i18n.server.ts --watch-path=src/i18n.ts --watch-path=src/index.tsx --watch-path=src/service-worker.ts --watch-path=server --watch-path=public --watch-path=legacy/index.html scripts/dev-ssr.mjs",
    "serve:ssr": "node server/index.mjs",
    "serve:runtime": "node scripts/start-runtime.mjs",
    "cache:clear:ssr": "node scripts/clear-ssr-cache.mjs",
    "preview": "npm run build && vite preview",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "audit:ci": "audit-ci --config ./audit-ci.jsonc",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "type-check": "react-router typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:ssr": "tsx scripts/ssr-smoke-test.ts",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "axios": "^1.15.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "5.2.2",
    "lucide-react": "0.563.0",
    "qs": "^6.15.0",
    "react": "^18.0.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.5.4",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "web-vitals": "^2.1.4",
    "xss": "1.0.17",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.0.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.58.1",
    "@react-router/dev": "7.18.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/babel__template": "^7.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "audit-ci": "7.1.0",
    "babel-plugin-istanbul": "^7.0.1",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.0.0",
    "test-exclude": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "test-exclude": "^7.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "qs": "^6.15.0",
    "minimatch": "^11.0.4",
    "serialize-javascript": "^7.1.4",
    "js-yaml": "4.3.2",
    "undici": "7.30.1",
    "postcss": "8.5.32",
    "brace-expansion": "5.0.12"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 15"
  ]
}
