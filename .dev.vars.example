# Copy to .dev.vars (gitignored) to override wrangler.jsonc `vars` locally.
# Used by `npm run dev`, `npm run preview` and `wrangler dev`.
ENVIRONMENT=development
SITE_DOMAIN=portfolio.local
API_URL=https://api.portfolio.local
GA_TRACKING_ID=
ENABLE_GA=false
SENTRY_DSN_FE=
PROJECT_OWNER=Portfolio Owner
# Server-side (Worker -> API) origin; default is the e2e mock backend.
SSR_API_URL=http://127.0.0.1:8765
# Local Edge Function API (backend repo: infra/scripts/run_local_api.sh) instead
# of the mock: use these three values. In deploys API_ORIGIN_SECRET is a Worker
# secret (`wrangler secret put`), never a `var`.
# SSR_API_URL=http://localhost:8001
# API_ORIGIN_SECRET=local-dev-secret
# Optional: serve /media/* from this origin (local Django, or test deploys
# without an origin route such as *.workers.dev).
# MEDIA_ORIGIN=http://localhost:8000
