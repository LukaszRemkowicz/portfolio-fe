{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-fe",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret public runtime config. Local-dev defaults; override per
  // environment (see .dev.vars.example). Exposed to code via process.env.
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_DOMAIN": "portfolio.local",
    "API_URL": "https://api.portfolio.local",
    "GA_TRACKING_ID": "",
    "ENABLE_GA": "false",
    "SENTRY_DSN_FE": "",
    "PROJECT_OWNER": "Portfolio Owner",
    "SSR_API_URL": "http://127.0.0.1:8765"
  },
  // Deploy environments. `vars` are NOT inherited from the top level, so local
  // defaults (e.g. SSR_API_URL=127.0.0.1, SITE_DOMAIN=portfolio.local) never
  // leak into staging/production. The remaining vars (SITE_DOMAIN, API_URL,
  // SSR_API_URL, GA_TRACKING_ID, ENABLE_GA, SENTRY_DSN_FE, PROJECT_OWNER) are
  // supplied at deploy time from Doppler. No routes/domains are declared here.
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "staging" }
    },
    "production": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
