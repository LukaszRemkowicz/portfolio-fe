{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-fe",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-01",
  // global_fetch_strictly_public: fetches to our own zone go through Cloudflare
  // like Internet traffic instead of short-circuiting inside the zone.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Non-secret public runtime config. Local-dev defaults; override per
  // environment (see .dev.vars.example). Exposed to code via process.env.
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_DOMAIN": "portfolio.local",
    "API_URL": "https://api.portfolio.local",
    "GA_TRACKING_ID": "",
    "ENABLE_GA": "false",
    "SENTRY_DSN_FE": "",
    "PROJECT_OWNER": "Portfolio Owner",
    "SSR_API_URL": "http://127.0.0.1:8765",
  },
  // Deploy environments. `vars` are NOT inherited from the top level, so local
  // defaults (e.g. SSR_API_URL=127.0.0.1, SITE_DOMAIN=portfolio.local) never
  // leak into staging/production. The remaining vars (SITE_DOMAIN, API_URL,
  // SSR_API_URL, GA_TRACKING_ID, ENABLE_GA, SENTRY_DSN_FE, PROJECT_OWNER) are
  // supplied at deploy time from Doppler. Secret API_ORIGIN_SECRET (shared
  // secret for the Supabase Edge Function API) is set with `wrangler secret put`. No routes/domains are declared here.
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "staging" },
    },
    "production": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "production" },
    },
    // Test Worker (portfolio-fe-supabase on workers.dev) against the hidden
    // Supabase API. SITE_DOMAIN/PROJECT_OWNER come from Doppler at deploy;
    // SSR_API_URL and API_ORIGIN_SECRET are Worker secrets. No GA, no Sentry.
    "supabase": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "ENABLE_GA": "false",
        "GA_TRACKING_ID": "",
        "SENTRY_DSN_FE": "",
      },
    },
  },
}
